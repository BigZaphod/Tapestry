{
    "html": [
        {
            "element": "link",
            "check": "type",
            "match": "/application/(?:json|feed\\+json)\\s*$/",
            "use": "href",
            "extract": "/^((?:(?!wp-json).)*)$/",
            "variable": "site",
            "comment": "The extract passes over WordPress API links for the next JSON link on the page"
        }
    ],
    "json": [
        {
            "key": "version",
            "value": "https://jsonfeed.org/version/1"
        },
        {
            "key": "version",
            "value": "https://jsonfeed.org/version/1.1"
        }
    ]
}
