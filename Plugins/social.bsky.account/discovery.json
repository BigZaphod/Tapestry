{
    "input": [
        {
            "match": "/^@?([a-zA-Z0-9-]+\\.bsky\\.social)$/",
            "url": "https://bsky.app/profile/$1"
        }
    ],
    "sites": [
        "bsky.app",
        "bsky.social"
    ],
    "url": [
        {
            "extract": "/https://[^/]+/profile/([^/]+)/",
            "variable": "account"
        }
    ],
    "dns": {
        "name": "_atproto",
        "match": "/^did=/",
        "variable": "account"
    }
}
